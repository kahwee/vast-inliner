{
  "name": "vast-inliner",
  "version": "3.0.0",
  "description": "Resolve VAST wrapper chains into a single inline VAST document",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/examples.md",
    "docs/migration-v3.md"
  ],
  "scripts": {
    "build": "bun run typecheck && bun run build:artifacts",
    "check": "bun run check:source && bun run build:artifacts && bun run package:check && bun audit",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "package:check": "publint && attw --pack . && node scripts/check-package.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "bun --check --tsconfig-override=tsconfig.json",
    "check:source": "bun run --parallel format:check typecheck test",
    "build:artifacts": "bun --bun tsdown"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "publint": "0.3.25",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/vast-inliner.git"
  },
  "author": {
    "name": "KahWee Teng",
    "email": "t@kw.sg",
    "url": "https://kahwee.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kahwee/vast-inliner/issues"
  },
  "homepage": "https://github.com/kahwee/vast-inliner#readme",
  "keywords": [
    "vast",
    "advertising",
    "video",
    "wrapper",
    "xml"
  ]
}
