{
  "name": "vast-inliner",
  "version": "2.0.1",
  "description": "Resolve VAST wrapper chains into a single inline VAST document",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run package:check && bun audit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "package:check": "publint && attw --pack .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "5.0.1",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/vast-inliner.git"
  },
  "author": {
    "name": "KahWee Teng",
    "email": "t@kw.sg",
    "url": "https://kahwee.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kahwee/vast-inliner/issues"
  },
  "homepage": "https://github.com/kahwee/vast-inliner#readme",
  "keywords": [
    "vast",
    "advertising",
    "video",
    "wrapper",
    "xml"
  ]
}
